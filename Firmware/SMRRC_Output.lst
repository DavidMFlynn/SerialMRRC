00028 01CC 	;
00029 01CC 	; RS485_Parse	(X/0) Parse any bytes received by the serial port
00030 01CC 	; Packet format: (DD DD) DA SA D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00031 01CC 	;  DD = Sync byte added if address is received
00032 01CC 	;  DA = Destination Address, SA = Source Address, 
00033 01CC 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00034 01CC 	;  SA RS485_SAddr ( the sender )
00035 01CC 	;  DA must be RS485_MyAddr ( this program, must match )
00036 01CC 	;  If the checksum matches put the data bytes in the RX485_Data buffer,
00037 01CC 	;   set RX485DataValidFlag and RX485DataIsNew.
00038 01CC 	;=========================================================================================
00039 01CC 	;
00040 01CC 	; default to a 6 byte packet 0xDD 0xDD DA SA D0 D1 D2 D3 CS
00041 01CC 	;
00042 01CC 	;
00043 01CC 		ifndef RP485_DataBytes
00045 01CC 		endif
00046 01CC 	;
00047 01CC 		ifndef UseRS485Chksum
00049 01CC 		endif
00050 01CC 	;
00051 01CC 		constant RX485Timeout=5	;50 mS max between incoming bytes
