00011 0000 	;
00012 0000 	;=========================================================================================
00013 0000 	;   Serial Model Railroad Control:
00014 0000 	;
00015 0000 	; RS485 Node. Sits on the RS485 bus and does stuff for the Railroad.
00016 0000 	; This version is for the Lighting Daughter Board.
00017 0000 	;
00018 0000 	;    History:
00019 0000 	; 0.9.1d   7/25/2026   Copied from SMRRC.asm 0.9.3a
00020 0000 	;
00021 0000 	;=========================================================================================
00022 0000 	; Options:
00023 0000 	;
00024 0000 	;=========================================================================================
00025 0000 	;=========================================================================================
00026 0000 	; What happens next:
00027 0000 	;   At power up the system LED will blink.
00028 0000 	;
00029 0000 	; When a command packet is received from RX1 (RS485):
00030 0000 	;  Source=any, Destination=Me: Parse and Process the command. 
00031 0000 	;     Send any requested data back to the sender on TX1 (RS485).
00032 0000 	;
00033 0000 	;=========================================================================================
00034 0000 	; uController pinout (PIC16F15345):
00035 0000 	;
00036 0000 	; Pin 1  (Vdd)		+5 Volts
00037 0000 	; Pin 2  (RA5)		LED2 (Active Low Input/Output)(LED2/Button2)
00038 0000 	; Pin 3  (RA4)		LED1 (Active Low Input/Output)(LED1/Button1)
00039 0000 	; Pin 4  (RA3/MCLR*)		VPP/MCLR*
00040 0000 	; Pin 5  (RC5)		I/O    Daughter Card Pin 10
00041 0000 	; Pin 6  (RC4)		I/O    Daughter Card Pin 9
00042 0000 	; Pin 7  (RC3)		I/O    Daughter Card Pin 8
00043 0000 	; Pin 8  (RC6)		I/O    Daughter Card Pin 11
00044 0000 	; Pin 9  (RC7)		I/O    Daughter Card Pin 12
00045 0000 	; Pin 10 (RB7/TX1)		RS-485 Driver
00046 0000 	; Pin 11 (RB6)		RS-485 Driver Enable (Active High Output)
00047 0000 	; Pin 12 (RB5)		RS-485 Receiver
00048 0000 	; Pin 13 (RB4)		RS-485 Receiver Enable (Active Low Output)
00049 0000 	; Pin 14 (RC2)		I/O    Daughter Card Pin 7
00050 0000 	; Pin 15 (RC1)		RX2 or I/O Daughter Card Pin 6
00051 0000 	; Pin 16 (RC0)		TX2 or I/O Daughter Card Pin 5
00052 0000 	; Pin 17 (RA2)		SYSLED (Active Low Output)(System LED)
00053 0000 	; Pin 18 (RRA/ICSPCLK)		ICSPCLK
00054 0000 	; Pin 19 (RA0/ICSPDAT)		ICSPDAT
00055 0000 	; Pin 20 (Vss)		Ground
00056 0000 	;
00057 0000 	;=========================================================================================
00058 0000 	;
00059 0000 		list	p=16F15345,r=hex,W=1	; list directive to define processor
00062 0000 		nolist
00063 0000 	;
00064 8007 1F8C 		__CONFIG _CONFIG1, b'0001111110001100'
00065 0000 	; FCMEM=0, RSTOSC=000 (32MHz), FEXTOSC=100
00066 0000 	;
00067 8008 3FFE 		__CONFIG _CONFIG2, b'0011111111111110'
00068 0000 	; MCLRE=0
00069 0000 	;
00070 8009 3F9F 		__CONFIG _CONFIG3, b'0011111110011111'
00071 0000 	;WDTE=00
00072 0000 	;
00073 800A 1FEF 		__CONFIG _CONFIG4, b'0001111111101111'
00074 0000 	; LVP=0, nSAFEN=0
00075 0000 	;
00076 800B 3FFF 		__CONFIG _CONFIG5, b'0011111111111111'
00077 0000 	;
00078 0000 	;=========================================================================================
00079 0000 	;
00080 0000 		constant	oldCode=0
00081 0000 		constant	useRS232=0	;TX2/RX2 to USB
00082 0000 		constant	useRS485=1	;TX1/RX1 to RS-485 SMRRC devices
00083 0000 		constant	useRS232PacketCmds=0
00084 0000 		constant	useRS485PacketCmds=1
00085 0000 		constant	useBootloader=0	;TX2/RX2 only.
00086 0000 		constant	UseEEParams=1
00087 0000 	;
00088 0000 		constant	RP_LongAddr=0
00089 0000 		constant	RP_AddressBytes=1
00090 0000 		constant	RP_DataBytes=4
00091 0000 		constant	UseRS232SyncBytes=1
00092 0000 00DD 	kRS232SyncByteValue	EQU	0xDD
00093 0000 		constant	UseRS232Chksum=1
00094 0000 	;
00095 0000 		constant	RP485_LongAddr=0
00096 0000 		constant	RP485_AddressBytes=1
00097 0000 		constant	RP485_DataBytes=4
00098 0000 		constant	UseRS485SyncBytes=1
00099 0000 00DD 	kRS485SyncByteValue	EQU	0xDD
00100 0000 		constant	UseRS485Chksum=1
00101 0000 	;
