00222 014A 	;=========================================================================================
00223 014A 	; Send one byte
00224 014A 	;  If there is a byte to send then turn on the TX and send it.
00225 014A 	;  If there is nothing to send then turn off the TX
00226 014A 	;
00227 014A 	; Entry: 
00228 014A 	; Exit: Bank0
00229 014A 	;
00230 014A 	;
00231 014A 0140 	TX_The485Byte	movlb                  0                      ;bank 0
00232 014B 1D3F 	                       btfss	RS485DataSentFlag	;Byte to send?
00233 014C 3205 	                       bra	TX_The485Byte_1	; yes
00234 014D 	;
00235 014D 	;See if there is a byte thet needs sending
00236 014D 21BB 	                       call	GetSer485Out	;get the next byte
00237 014E 1C78 		btfss	Param78,0	;We have a byte?
00238 014F 3211 		bra	TX_The485Byte_NoData	; No
00239 0150 00BD 		movwf	TX485Byte	; in bank 0
00240 0151 113F 		bcf	RS485DataSentFlag
00241 0152 	;
00242 0152 	; We have a byte to send is TX on?
