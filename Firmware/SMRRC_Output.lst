00159 0121 0140 	RS485DeactivateTX	movlb	0	;bank 0
00160 0122 1C3F 		btfss	RS485TXActive	;TX mode?
00161 0123 320F 		bra	RS485DeactivateTX_End	; No, we're done here
00162 0124 	; finish TX if there are bytes in the buffer
00163 0124 1D3F 		btfss	RS485DataSentFlag	;Byte is waiting?
00164 0125 320D 		bra	RS485DeactivateTX_End	; Yes, do nothing
00165 0126 	;
00166 0126 014E 		movlb	PIR3	;bank 14
00167 0127 1E0F 		btfss	PIR3,TX1IF	;TX done?
00168 0128 320A 		bra	RS485DeactivateTX_End	; No
00169 0129 0142 		movlb	TX1STA	;bank 2
00170 012A 1C9E 		btfss	TX1STA,TX1STA_TRMT	;bits all shifted?
00171 012B 3207 		bra	RS485DeactivateTX_End	; No, not yet
00172 012C 	;
00173 012C 0142 	RS485DeactivateTX_1	movlb	TX1STA
00174 012D 129E 		bcf	TX1STA,TX1STA_TXEN	;Transmitter Off
00175 012E 	;
