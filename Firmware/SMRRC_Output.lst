00177 012F 103F 		bcf	RS485TXActive
00178 0130 1319 		bcf	RS485DE	;DriverEnable=0
00179 0131 1219 		bcf	RS485nRE	;nRecieverEnable=0
00180 0132 	;tc
00181 0132 17AE 		bsf	LED2_Active
00182 0133 	;etc
00183 0133 0140 	RS485DeactivateTX_End	movlb	0
00184 0134 	;tc
