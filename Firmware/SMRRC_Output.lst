00244 0153 2136 		call	RS485ActivateTX	; No
00245 0154 1C3F 		btfss	RS485TXActive	;In transmit mode?
00246 0155 3209 		bra	TX_The485Byte_End	; No
00247 0156 	; TX buffer empty?
00248 0156 014E 		movlb	PIR3
00249 0157 1E0F 		btfss	PIR3,TX1IF	;TX done?
00250 0158 3206 		bra	TX_The485Byte_End
00251 0159 	; Send it
00252 0159 0140 		movlb	0	;bank 0
00253 015A 083D 		movf	TX485Byte,W	
00254 015B 0142 		movlb	TX1REG                 ;bank 2
00255 015C 009A 		movwf	TX1REG
00256 015D 0140 		movlb	0                      ;bank 0
00257 015E 153F 		bsf	RS485DataSentFlag
00258 015F 	;
00259 015F 0140 	TX_The485Byte_End	movlb	0	;bank 0
00260 0160 0008 		return
