00050 0121 	; Routines	(Bank In/Bank Out)
00051 0121 	;
00052 0121 	; TX_The485Byte	(X/0) Send one byte to UART
00053 0121 	; RX_The485Byte	(X/0) Receive one byte from UART
00054 0121 	; StoreSer485In	(X/0) Put the byte in W into the serial input buffer, FSR0
00055 0121 	; GetSer485In	(X/0) Get a byte from the serial input buffer, FSR0
00056 0121 	; Flush485InBuff	(X/0) Flush the serial incoming buffer.
00057 0121 	; GetSer485InBytes	(X/0) Get the number of bytes in the serial input buffer
00058 0121 	; GetSer485OutBytes	(X/0) Get the number of bytes in the serial ouput buffer
00059 0121 	; StoreSer485Out	(X/0) Put the byte in W into the serial output buffer, FSR0
00060 0121 	; POP_Ser485Out	(X/0) Remove the last char stored in the output buffer
00061 0121 	; GetSer485Out	(X/0) Get a byte from the serial Output buffer, FSR0
00062 0121 	;	       W=Byte, Param78:0=ValidFlag
00063 0121 	; RS485DeactivateTX	(X/0) If TX is Idle disable it. RS485TXActive=0
00064 0121 	; RS485ActivateTX	(X/0) RS485TXActive=1
