00276 0166 081D 		MOVF	RC1STA,W
00277 0167 3906 		ANDLW	0x06
00278 0168 		SKPZ		;Frame or Overrun Err?
00278 0168 1D03      M		BTFSS	STATUS,Z		BTFSS	STATUS,Z
00279 0169 3206 		bra	RX_The485Byte_Err	; yes
00280 016A 	;
