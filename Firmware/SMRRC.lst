00011 0000 	;
00012 0000 	;=========================================================================================
00013 0000 	;   Serial Model Railroad Control:
00014 0000 	;
00015 0000 	; USB to RS485 Buffer and translator. Sits between a desctop computer and the Railroad.
00016 0000 	;
00017 0000 	;    History:
00018 0000 	; 0.9.3a   7/19/2026   Node types.
00019 0000 	; 0.9.2a   7/13/2026   Good data to/from Master. Working on RS485...
00020 0000 	; 0.9.1a   7/9/2026	It compiles...
00021 0000 	; 0.9a   4/1/2025	Copied from BLDC_Servo, Blink an LED
00022 0000 	;
00023 0000 	;=========================================================================================
00024 0000 	; Options:
00025 0000 	;
00026 0000 	;=========================================================================================
00027 0000 	;=========================================================================================
00028 0000 	; What happens next:
00029 0000 	;   At power up the system LED will blink.
00030 0000 	;
00031 0000 	; When a command packet is received from RX2 (USB):
00032 0000 	;  Source=Master, Destination=Me: Parse and Process the command.
00033 0000 	;     Send any requested data back to Master on TX2 (USB).
00034 0000 	;  Source=Master, Destination<>Me: Retransmit on TX1 (RS485)
00035 0000 	;
00036 0000 	; When a command packet is received from RX1 (RS485):
00037 0000 	;  Source=any, Destination=Me: Parse and Process the command. 
00038 0000 	;     Send any requested data back to the sender on TX1 (RS485).
00039 0000 	;  Source=any, Destination=Master: Retransmit on TX2 (USB)
00040 0000 	;  Source=any, Destination= other than Master or Me do nothing.
00041 0000 	;
00042 0000 	;=========================================================================================
00043 0000 	; uController pinout (PIC16F15345):
00044 0000 	;
00045 0000 	; Pin 1  (Vdd)		+5 Volts
00046 0000 	; Pin 2  (RA5)		LED2 (Active Low Input/Output)(LED2/Button2)
00047 0000 	; Pin 3  (RA4)		LED1 (Active Low Input/Output)(LED1/Button1)
00048 0000 	; Pin 4  (RA3/MCLR*)		VPP/MCLR*
00049 0000 	; Pin 5  (RC5)		I/O    Daughter Card Pin 10
00050 0000 	; Pin 6  (RC4)		I/O    Daughter Card Pin 9
00051 0000 	; Pin 7  (RC3)		I/O    Daughter Card Pin 8
00052 0000 	; Pin 8  (RC6)		I/O    Daughter Card Pin 11
00053 0000 	; Pin 9  (RC7)		I/O    Daughter Card Pin 12
00054 0000 	; Pin 10 (RB7/TX1)		RS-485 Driver
00055 0000 	; Pin 11 (RB6)		RS-485 Driver Enable (Active High Output)
00056 0000 	; Pin 12 (RB5)		RS-485 Receiver
00057 0000 	; Pin 13 (RB4)		RS-485 Receiver Enable (Active Low Output)
00058 0000 	; Pin 14 (RC2)		I/O    Daughter Card Pin 7
00059 0000 	; Pin 15 (RC1)		RX2 or I/O Daughter Card Pin 6
00060 0000 	; Pin 16 (RC0)		TX2 or I/O Daughter Card Pin 5
00061 0000 	; Pin 17 (RA2)		SYSLED (Active Low Output)(System LED)
00062 0000 	; Pin 18 (RRA/ICSPCLK)		ICSPCLK
00063 0000 	; Pin 19 (RA0/ICSPDAT)		ICSPDAT
00064 0000 	; Pin 20 (Vss)		Ground
00065 0000 	;
00066 0000 	;=========================================================================================
00067 0000 	;
