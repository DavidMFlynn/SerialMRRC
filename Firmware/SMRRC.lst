00027 0800 	;
00028 0800 0093 	kCmd_ReBoot	EQU	0x93	;ReBoot the controller
00029 0800 0094 	kCmd_SaveParams	EQU	0x94	;Save all eeprom params, return ACK
00030 0800 0095 	kCmd_RestoreParams	EQU	0x95	;Copy to ram, return ACK
00031 0800 0098 	kCmd_GetStatus	EQU	0x98	;return ssStatus
00032 0800 0099 	kCmd_RunBootloader	EQU	0x99	;Set EEPROM (0xFF) = 0xFF and reboot
00033 0800 	;
00034 0800 	; these commands save params and return a 0,0,0,0 packet with the new address
00035 0800 00A1 	kCmd_SetMasterAddr	EQU	0xA1	;+1 data, return a zero packet
