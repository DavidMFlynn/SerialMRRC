00023 031A 	;
00024 031A 	; RS485_Parse	(X/0) Parse any bytes received by the serial port
00025 031A 	; Packet format: (DD DD) DA SA D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00026 031A 	;  DD = Sync byte added if address is received
00027 031A 	;  DA = Destination Address, SA = Source Address, 
00028 031A 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00029 031A 	;  SA RS485_SAddr ( the sender )
00030 031A 	;  DA must be RS485_MyAddr ( this program, must match )
SMRRC.asm                                                             Page: 25
