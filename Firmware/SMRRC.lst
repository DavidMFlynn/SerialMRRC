00019 0129 	; Notes:
00020 0129 	;
00021 0129 	; History:
00022 0129 	; 1.0b5  5/25/2018	RS232_MasterAddr, RS232_SlaveAddr now in ram
00023 0129 	; 1.0d4  5/18/2018	Added RS232_ClearTXData, RS232_Send.
00024 0129 	; 1.0d3  5/17/2018	Used Timer1Lo for RXTimeout.
00025 0129 	; 1.0d2  4/26/2018	Comments, used in robot arm project.
00026 0129 	; 1.0d1  1/12/2016	Modified for I2C to RS-232 8 byte packets.
00027 0129 	; 1.0d1  11/9/2015	Adapted for QD Tester
00028 0129 	; 1.0    12/6/2013	First Rev'd version
00029 0129 	;
00030 0129 	; RS232_Parse	(X/0) Parse any bytes received by the serial port
00031 0129 	; Packet format: (FF FF) SA0 (SA1) DA0 (DA1) D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00032 0129 	;  FF = Sync byte, SAn = Source Address, DA = Destination Address,
00033 0129 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00034 0129 	;  SA must be RS232_RAddr ( the boss )
00035 0129 	;  DA must be RS232_MyAddr ( this program )
00036 0129 	;  If the checksum matches put the data bytes in the RX_Data buffer,
00037 0129 	;   set RXDataValidFlag and RXDataIsNew.
00038 0129 	;=========================================================================================
00039 0129 	;	constant RP_LongAddr=1		;16 bit addresses
00040 0129 	; default to a 6 byte packet SA DA D0 D1 D2 D3
00041 0129 	;
00042 0129 		ifndef UseRS232SyncBytes
00044 0129 		endif
00045 0129 	;
00046 0129 		ifndef UseRS232SendSyncBytes
00048 0129 		endif
00049 0129 	;
00050 0129 		ifndef RP_LongAddr
00052 0129 		endif
00053 0129 	;
00054 0129 		ifndef RP_DataBytes
00056 0129 		endif
00057 0129 	;
00058 0129 		ifndef UseRS232Chksum
00060 0129 		endif
00061 0129 	;
00062 0129 		constant RXTimeout=5		;50 mS max between incoming bytes
