00102 0129 	;=========================================================================================
00103 0129 	; Parse any bytes received by the serial port
00104 0129 	;
00105 0129 	; Receive 0xFF,0xFF,SA0,(SA1),DA0,(DA1),Cmd,Data0,Data1,Data2,CS
00106 0129 	;
00107 0129 	;
00108 0129 	; Entry: none
00109 0129 	; Exit: none
00110 0129 	; Ram Used: Param78, FSR
00111 0129 	; Calls (1+0): GetSerIn
00112 0129 	;
00113 0129 0141 	RS232_Parse	movlb	0x01	;bank 1
00114 012A 08A0 		movf	RX_ParseFlags,F
00115 012B 		SKPNZ		;Receive in process?
00115 012B 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00116 012C 3207 		bra	RS232_Parse_Byte	; no
00117 012D 	;
00118 012D 0140 		movlb	0	;bank 0
00119 012E 08AC 		movf	Timer1Lo,F
00120 012F 		SKPZ		;Timed out?
00120 012F 1D03      M		BTFSS	STATUS,Z		BTFSS	STATUS,Z
00121 0130 3203 		bra	RS232_Parse_Byte	; no
00122 0131 	;timed out
00123 0131 15B6 		bsf	ssRX_Timeout
00124 0132 0141 		movlb	0x01	;bank 1
00125 0133 01A0 		clrf	RX_ParseFlags
00126 0134 	;
00127 0134 20E3 	RS232_Parse_Byte	CALL	GetSerIn
00128 0135 1C78 		BTFSS	Param78,0	;Got a byte?
00129 0136 0008 		RETURN		; No
00130 0137 	;
00131 0137 00F8 		MOVWF	Param78	;Data Byte RXd
00132 0138 3005 		movlw	RXTimeout	;Reset time-out timer
00133 0139 00AC 		movwf	Timer1Lo
00134 013A 	; Command inturpreter
00135 013A 		if UseRS232SyncBytes
00136 013A 	;
00137 013A 0141 		movlb	0x01	;bank 1
