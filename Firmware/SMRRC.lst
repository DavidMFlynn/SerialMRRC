00050 0256 	; Routines	(Bank In/Bank Out)
00051 0256 	;
00052 0256 	; TX_The485Byte	(X/0) Send one byte to UART
00053 0256 	; RX_The485Byte	(X/0) Receive one byte from UART
00054 0256 	; StoreSer485In	(X/0) Put the byte in W into the serial input buffer, FSR0
00055 0256 	; GetSer485In	(X/0) Get a byte from the serial input buffer, FSR0
00056 0256 	; Flush485InBuff	(X/0) Flush the serial incoming buffer.
00057 0256 	; GetSer485InBytes	(X/0) Get the number of bytes in the serial input buffer
00058 0256 	; GetSer485OutBytes	(X/0) Get the number of bytes in the serial ouput buffer
00059 0256 	; StoreSer485Out	(X/0) Put the byte in W into the serial output buffer, FSR0
00060 0256 	; POP_Ser485Out	(X/0) Remove the last char stored in the output buffer
00061 0256 	; GetSer485Out	(X/0) Get a byte from the serial Output buffer, FSR0
00062 0256 	;	       W=Byte, Param78:0=ValidFlag
00063 0256 	; RS485DeactivateTX	(X/0) If TX is Idle disable it. RS485TXActive=0
00064 0256 	; RS485ActivateTX	(X/0) RS485TXActive=1
