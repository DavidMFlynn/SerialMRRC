00108 032D 0144 		movlb	Ser485_Buff_Bank
00109 032E 01A0 		clrf	RX485_ParseFlags
00110 032F 	;
00111 032F 22DE 	RS485_Parse_Byte	CALL	GetSer485In
00112 0330 1C78 		BTFSS	Param78,0	;Got a byte?
00113 0331 0008 		RETURN		; No
00114 0332 	;
00115 0332 00F8 		MOVWF	Param78	;Data Byte RXd
00116 0333 3005 		movlw	RX485Timeout	;Reset time-out timer
00117 0334 00AE 		movwf	Timer2Lo
