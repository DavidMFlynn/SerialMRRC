00049 026F 	;=========================================================================================
00050 026F 	; Routines	(Bank In/Bank Out)
00051 026F 	;
00052 026F 	; TX_The485Byte	(X/0) Send one byte to UART
00053 026F 	; RX_The485Byte	(X/0) Receive one byte from UART
00054 026F 	; StoreSer485In	(X/0) Put the byte in W into the serial input buffer, FSR0
00055 026F 	; GetSer485In	(X/0) Get a byte from the serial input buffer, FSR0
00056 026F 	; Flush485InBuff	(X/0) Flush the serial incoming buffer.
00057 026F 	; GetSer485InBytes	(X/0) Get the number of bytes in the serial input buffer
00058 026F 	; GetSer485OutBytes	(X/0) Get the number of bytes in the serial ouput buffer
00059 026F 	; StoreSer485Out	(X/0) Put the byte in W into the serial output buffer, FSR0
00060 026F 	; POP_Ser485Out	(X/0) Remove the last char stored in the output buffer
00061 026F 	; GetSer485Out	(X/0) Get a byte from the serial Output buffer, FSR0
00062 026F 	;	       W=Byte, Param78:0=ValidFlag
00063 026F 	; RS485DeactivateTX	(X/0) If TX is Idle disable it. RS485TXActive=0
00064 026F 	; RS485ActivateTX	(X/0) RS485TXActive=1
00065 026F 	;=========================================================================================
00066 026F 	;=========================================================================================
