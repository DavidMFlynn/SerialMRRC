00021 02FB 	; History:
00022 02FB 	; 1.0d1  4/5/2025	Copied from RS232_Parse 1.0b5
00023 02FB 	;
00024 02FB 	; RS485_Parse	(X/0) Parse any bytes received by the serial port
00025 02FB 	; Packet format: SA0 (SA1) DA0 (DA1) D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00026 02FB 	;  SAn = Source Address, DA = Destination Address,
00027 02FB 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00028 02FB 	;  SA RS485_SAddr ( the sender )
00029 02FB 	;  DA must be RS485_MyAddr ( this program, must match )
00030 02FB 	;  If the checksum matches put the data bytes in the RX485_Data buffer,
00031 02FB 	;   set RX485DataValidFlag and RX485DataIsNew.
00032 02FB 	;=========================================================================================
00033 02FB 	;	constant RP485_LongAddr=1	;16 bit addresses
00034 02FB 	; default to a 6 byte packet SA DA D0 D1 D2 D3
00035 02FB 	;
00036 02FB 	;
00037 02FB 		ifndef RP485_LongAddr
00039 02FB 		endif
00040 02FB 	;
00041 02FB 		ifndef RP485_DataBytes
00043 02FB 		endif
00044 02FB 	;
00045 02FB 		ifndef UseRS485Chksum
00047 02FB 		endif
00048 02FB 	;
00049 02FB 		constant RX485Timeout=5	;50 mS max between incoming bytes
00050 02FB 	;=========================================================================================
