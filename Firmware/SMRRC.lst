00068 02FB 	;	RX485_Data:RP485_DataBytes
00069 02FB 	;	TX485_Data:RP485_DataBytes
00070 02FB 	;	endc
00071 02FB 	;RX485_ParseFlags Bits
00072 02FB 0220 	#Define	RS485SourceAddLoRXd	RX485_ParseFlags,2
00073 02FB 0220 	#Define	RS485SourceAddHiRXd	RX485_ParseFlags,3
00074 02FB 0220 	#Define	RS485DestAddLoRXd	RX485_ParseFlags,4
