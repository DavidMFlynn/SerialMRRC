00129 033C 1D03      M		BTFSS	STATUS,Z		BTFSS	STATUS,Z
00130 033D 11A1 		bcf	RX485DstIsMe	; No
00131 033E 16B9 		bsf	RS485DestAddLoRXd
00132 033F 0878 		movf	Param78,W
00133 0340 00A5 		movwf	RX485_DstAdd	;Save RXd byte as dest addr
00134 0341 06A3 		xorwf	RX485_CSUM,F
00135 0342 3210 		bra	RS485_Parse_Rtn
00136 0343 	RS485_Parse_DALo_End:
00137 0343 	;
00138 0343 	; Source Address
