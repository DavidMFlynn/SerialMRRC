00047 013C 		endif
00048 013C 	;
00049 013C 		ifndef UseRS232SendSyncBytes
00051 013C 		endif
00052 013C 	;
00053 013C 		ifndef RP_LongAddr
00055 013C 		endif
00056 013C 	;
00057 013C 		ifndef RP_DataBytes
00059 013C 		endif
00060 013C 	;
00061 013C 		ifndef UseRS232Chksum
00063 013C 		endif
