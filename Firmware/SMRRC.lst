00027 013C 	; 1.0d1  11/9/2015	Adapted for QD Tester
00028 013C 	; 1.0    12/6/2013	First Rev'd version
00029 013C 	;
00030 013C 	; RS232_Parse	(X/0) Parse any bytes received by the serial port
00031 013C 	; Packet format: (FF FF) SA0 (SA1) DA0 (DA1) D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00032 013C 	;  FF = Sync byte, SAn = Source Address, DA = Destination Address,
00033 013C 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00034 013C 	;  SA must be RS232_RAddr ( the boss )
00035 013C 	;  DA must be RS232_MyAddr ( this program )
00036 013C 	;  If the checksum matches put the data bytes in the RX_Data buffer,
00037 013C 	;   set RXDataValidFlag and RXDataIsNew.
00038 013C 	;=========================================================================================
00039 013C 	;	constant RP_LongAddr=1		;16 bit addresses
00040 013C 	; default to a 6 byte packet SA DA D0 D1 D2 D3
00041 013C 	;
00042 013C 		ifndef UseRS232SyncBytes
00044 013C 		endif
00045 013C 	;
00046 013C 		ifndef UseRS232SendSyncBytes
00048 013C 		endif
00049 013C 	;
00050 013C 		ifndef RP_LongAddr
00052 013C 		endif
00053 013C 	;
00054 013C 		ifndef RP_DataBytes
00056 013C 		endif
00057 013C 	;
00058 013C 		ifndef UseRS232Chksum
00060 013C 		endif
00061 013C 	;
00062 013C 		constant RXTimeout=5		;50 mS max between incoming bytes
00063 013C 	;=========================================================================================
