00452 0004      M	; Interupt Service Routine
00453 0004      M	;
00454 0004      M	; we loop through the interupt service routing every 0.008192 seconds
00455 0004      M	;
00456 0004      M	;
00457 0004      M		ORG	0x004	; interrupt vector location
00458 0004 018A      M		CLRF	PCLATH
00459 0005 0140      M		movlb	0	; bank 0
00460 0006      M	;
00461 0006      M	;=============================
