00001 1D00 	;************************************************
00002 1D00 	; BootLoader for PIC16F15345
00003 1D00 	; filename: Bootloader15345.inc
00004 1D00 	; Created: 4/4/2025
00005 1D00 	; Revision: 1.0d1 4/4/2025
00006 1D00 	;************************************************
00007 1D00 	; History
00008 1D00 	; 1.0d1 4/4/2025	Copied from Bootloader18346.inc Rev 1.0b1
00009 1D00 	;************************************************
00010 1D00 	; Notes:
00011 1D00 	;
00012 1D00 	; WDT is not suported.
00013 1D00 	;
00014 1D00 	;  Does not program data EEProm, or other than prog mem 0..BootLoaderStart-1
00015 1D00 	;
00016 1D00 	; Must be the last thing in prog mem, will not overwrite itself or anything after it.
00017 1D00 	;
00018 1D00 	;BootLoaderStart	EQU	0x1E00
00019 1D00 	;	org BootLoaderStart
00020 1D00 	;	include <Bootloader18854.inc>
00021 1D00 	;
00022 1D00 	;  Reset vector:
00023 1D00 	;  	movlp	high BootLoaderStart
00024 1D00 	;    	goto	BootLoaderStart
00025 1D00 	;  ProgStartVector	CLRF	PCLATH
00026 1D00 	;	goto	Start
00027 1D00 	;
00028 1D00 	;  DataEEProm (0xFF) = 0xFF = run bootloader
00029 1D00 	;
00030 1D00 	; What happens next:
00031 1D00 	;  If Data EEProm address (0xFF) <> 0xFF then goto ProgStartVector
SMRRC.asm                                                             Page: 34
/Users/davidflynn/Projects/SerialMRRC/Firmware/

00032 1D00 	;  Setup  UART for 38.4KBaud
00033 1D00 	;  Parse incoming text as .hex file
00034 1D00 	;   if program memory address > 0 and < BootLoader then
00035 1D00 	;    read block from prog mem
00036 1D00 	;    if compare blocks then
00037 1D00 	;      if prog mem is not blank then erase block
00038 1D00 	;    write block
00039 1D00 	;
00040 1D00 	;  DataEEProm (0xFF) = 0x00
00041 1D00 	;
00042 1D00 	;  reset
00043 1D00 	;************************************************
00044 1D00 	; .hex
00045 1D00 	;:020000040000FA 
00046 1D00 	;       ^^^^^^ Set high word of address to 0x0000
00047 1D00 	;:100010005A23582356235423422021000C16200033
00048 1D00 	;:100020003A100C1E3A14A10B053221000C122000CC
00049 1D00 	;^ Start code                             ^^ Checksum
00050 1D00 	; ^^ Bytes of data (0x10)
00051 1D00 	;   ^^^^ Address low word (0x0020)
00052 1D00 	;       ^^ Record type 0x00 = Data
00053 1D00 	;         ^^^^ LSB MSB of data for Addr / 2
00054 1D00 	;                                         
00055 1D00 	; Checksum is 2's complement of all other bytes added together
00056 1D00 	; Valid address range 0000 0000 .. 0000 3BFE (bootloader is at 0000 3C00 .. 0000 3FFF, 512 words)
00057 1D00 	;************************************************
00058 1D00 	;
00059 1D00 	;
00060 1D00 		cblock 0x20
00061 1D00 0020 M		PROG_ADDR_LO                                  ;word address PC
00062 1D00 0021 M		PROG_ADDR_HI                                  ; high 7 bits of PC
00063 1D00 0022 M		ProgWordCount                                 ;Words in SourceBuffer
00064 1D00      M		
00065 1D00 0023 M		IH_Addr_Lo:2		;
00066 1D00 0025 M		IH_Addr_Hi:2		;extended linear address, alway 0x0000 for Prog mem
00067 1D00 0027 M		IH_Bytes
00068 1D00 0028 M		IH_ByteCount
00069 1D00 0029 M		IH_Type		;Record Type 0..5
00070 1D00 002A M		IH_State
00071 1D00 002B M		IH_TempVal
00072 1D00 002C M		IH_Flags
00073 1D00 002D M		ChkSum
00074 1D00      M		endc
00075 1D00      M	;
00076 1D00 002C M	#Define	MSN_Done	IH_Flags,0	;Most Significant Nibble
00077 1D00 002C M	#Define	DataInBuffer	IH_Flags,1             ;SourceBuffer has data
00078 1D00      M	;
00079 1D00      M	;IH_Type: Intel Hex Types
00080 1D00 0000 M	IHT_Data	EQU	0x00
00081 1D00 0001 M	IHT_End	EQU	0x01	;ie :00000001FF
00082 1D00 0002 M	IHT_XSA	EQU	0x02	;extended segment address, not supported
00083 1D00 0003 M	IHT_SSA	EQU	0x03	;start segment address, not supported
00084 1D00 0004 M	IHT_HighAddr	EQU	0x04	;extended linear address, :02000004FFFFFC
00085 1D00 0005 M	IHT_SLA	EQU	0x05	;start linear address, not supported, :04000005000000CD2A
00086 1D00      M	;
00087 1D00      M	;IH_State values
00088 1D00 0000 M	IHS_WaitForColon	EQU	0x00
00089 1D00 0001 M	IHS_Length	EQU	0x01
00090 1D00 0002 M	IHS_AddrMSB	EQU	0x02
00091 1D00 0003 M	IHS_AddrLSB	EQU	0x03
00092 1D00 0004 M	IHS_DataType	EQU	0x04
00093 1D00 0005 M	IHS_Data	EQU	0x05
00094 1D00 0006 M	IHS_CSum	EQU	0x06	;waiting for check sum
00095 1D00      M	;
00096 1D00 002B M	IH_ErrorBadLen	EQU	'+'	;>64 Too big
00097 1D00 002D M	IH_ErrorBadCSum	EQU	'-'	;Checksum didn't match
00098 1D00 003D M	IH_ErrorBadType        EQU                    '='                    ;IH_Type not recognized 
00099 1D00 002A M	IH_Ack	EQU	'*'	;We got a good Intel Hex line
00100 1D00      M	;
00101 1D00 0040 M	BlockSize	EQU	0x40
00102 1D00 0020 M	BlockWords	EQU	BlockSize/2	;0x20
00103 1D00 00E0 M	AddressMask	EQU	0xE0
00104 1D00      M	;
00105 1D00      M	;Contiguous ram 0x2000..0x21EF, 496 bytes
00106 1D00      M		cblock 0x2100		;0x0100 after start of ram
00107 1D00 2100 M		SourceBuffer:BlockSize
00108 1D00 2140 M		DestBuffer:BlockSize
00109 1D00 2180 M		SerialBuffer:BlockSize
00110 1D00      M		endc
00111 1D00      M	;
