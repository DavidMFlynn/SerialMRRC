00033 013C 	; RS232_Parse	(X/0) Parse any bytes received by the serial port
00034 013C 	; Packet format: (FF FF) SA0 (SA1) DA0 (DA1) D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00035 013C 	;  FF = Sync byte, SAn = Source Address, DA = Destination Address,
00036 013C 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00037 013C 	;  SA must be RS232_RAddr ( the boss )
SMRRC.asm                                                             Page: 14
/Users/davidflynn/Projects/SerialMRRC/Firmware/

00038 013C 	;  DA must be RS232_MyAddr ( this program )
00039 013C 	;  If the checksum matches put the data bytes in the RX_Data buffer,
00040 013C 	;   set RXDataValidFlag and RXDataIsNew.
00041 013C 	;=========================================================================================
00042 013C 	;	constant RP_LongAddr=1		;16 bit addresses
00043 013C 	; default to a 6 byte packet SA DA D0 D1 D2 D3
00044 013C 	;
