00019 0000 	;=========================================================================================
00020 0000 	; Options:
00021 0000 	;
00022 0000 	;=========================================================================================
00023 0000 	;=========================================================================================
00024 0000 	; What happens next:
00025 0000 	;   At power up the system LED will blink.
00026 0000 	;
00027 0000 	;=========================================================================================
00028 0000 	; uController pinout (PIC16F15345):
00029 0000 	;
00030 0000 	; Pin 1  (Vdd)		+5 Volts
00031 0000 	; Pin 2  (RA5)		LED2 (Active Low Input/Output)(LED2/Button2)
00032 0000 	; Pin 3  (RA4)		LED1 (Active Low Input/Output)(LED1/Button1)
00033 0000 	; Pin 4  (RA3/MCLR*)		VPP/MCLR*
00034 0000 	; Pin 5  (RC5)		I/O    Daughter Card Pin 10
00035 0000 	; Pin 6  (RC4)		I/O    Daughter Card Pin 9
00036 0000 	; Pin 7  (RC3)		I/O    Daughter Card Pin 8
00037 0000 	; Pin 8  (RC6)		I/O    Daughter Card Pin 11
00038 0000 	; Pin 9  (RC7)		I/O    Daughter Card Pin 12
00039 0000 	; Pin 10 (RB7/TX1)		RS-485 Driver
00040 0000 	; Pin 11 (RB6)		RS-485 Driver Enable (Active High Output)
00041 0000 	; Pin 12 (RB5)		RS-485 Receiver
00042 0000 	; Pin 13 (RB4)		RS-485 Receiver Enable (Active Low Output)
00043 0000 	; Pin 14 (RC2)		I/O    Daughter Card Pin 7
00044 0000 	; Pin 15 (RC1)		RX2 or I/O Daughter Card Pin 6
00045 0000 	; Pin 16 (RC0)		TX2 or I/O Daughter Card Pin 5
00046 0000 	; Pin 17 (RA2)		SYSLED (Active Low Output)(System LED)
00047 0000 	; Pin 18 (RRA/ICSPCLK)		ICSPCLK
00048 0000 	; Pin 19 (RA0/ICSPDAT)		ICSPDAT
00049 0000 	; Pin 20 (Vss)		Ground
00050 0000 	;
00051 0000 	;=========================================================================================
00052 0000 	;
00053 0000 		list	p=16F15345,r=hex,W=1	; list directive to define processor
00056 0000 		nolist
