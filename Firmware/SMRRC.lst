00023 0324 	;
00024 0324 	; RS485_Parse	(X/0) Parse any bytes received by the serial port
00025 0324 	; Packet format: (DD DD) DA SA D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00026 0324 	;  DD = Sync byte added if address is received
00027 0324 	;  DA = Destination Address, SA = Source Address, 
00028 0324 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00029 0324 	;  SA RS485_SAddr ( the sender )
00030 0324 	;  DA must be RS485_MyAddr ( this program, must match )
00031 0324 	;  If the checksum matches put the data bytes in the RX485_Data buffer,
00032 0324 	;   set RX485DataValidFlag and RX485DataIsNew.
00033 0324 	;=========================================================================================
00034 0324 	;
00035 0324 	; default to a 6 byte packet 0xDD 0xDD DA SA D0 D1 D2 D3 CS
00036 0324 	;
00037 0324 	;
00038 0324 		ifndef RP485_DataBytes
00040 0324 		endif
00041 0324 	;
00042 0324 		ifndef UseRS485Chksum
00044 0324 		endif
00045 0324 	;
00046 0324 		constant RX485Timeout=5	;50 mS max between incoming bytes
00047 0324 	;=========================================================================================
00048 0324 	; Bank0 variable used by RS232_Parse:
00049 0324 	;
00050 0324 	;	cblock
00051 0324 	;	RS485_Address
00052 0324 	;	endc
00053 0324 	;
