00048 028C 	; TX_The485Byte	(X/0) Send one byte to UART
00049 028C 	; RX_The485Byte	(X/0) Receive one byte from UART
00050 028C 	; StoreSer485In	(X/0) Put the byte in W into the serial input buffer, FSR0
00051 028C 	; GetSer485In	(X/0) Get a byte from the serial input buffer, FSR0
00052 028C 	; Flush485InBuff	(X/0) Flush the serial incoming buffer.
00053 028C 	; GetSer485InBytes	(X/0) Get the number of bytes in the serial input buffer
00054 028C 	; GetSer485OutBytes	(X/0) Get the number of bytes in the serial ouput buffer
00055 028C 	; StoreSer485Out	(X/0) Put the byte in W into the serial output buffer, FSR0
00056 028C 	; POP_Ser485Out	(X/0) Remove the last char stored in the output buffer
00057 028C 	; GetSer485Out	(X/0) Get a byte from the serial Output buffer, FSR0
00058 028C 	;	       W=Byte, Param78:0=ValidFlag
