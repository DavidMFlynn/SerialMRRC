00055 028C 	; GetSer485In	(X/0) Get a byte from the serial input buffer, FSR0
00056 028C 	; Flush485InBuff	(X/0) Flush the serial incoming buffer.
00057 028C 	; GetSer485InBytes	(X/0) Get the number of bytes in the serial input buffer
00058 028C 	; GetSer485OutBytes	(X/0) Get the number of bytes in the serial ouput buffer
00059 028C 	; StoreSer485Out	(X/0) Put the byte in W into the serial output buffer, FSR0
00060 028C 	; POP_Ser485Out	(X/0) Remove the last char stored in the output buffer
