00098 0325 08A0 		movf	RX485_ParseFlags,F
00099 0326 		SKPNZ		;Receive in process?
00099 0326 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00100 0327 3207 		bra	RS485_Parse_Byte	; no
00101 0328 	;
00102 0328 0140 		movlb	0	;bank 0
00103 0329 08AE 		movf	Timer2Lo,F
00104 032A 		SKPZ		;Timed out?
