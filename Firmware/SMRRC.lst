00028 0301 	;
00029 0301 	; RS485_Parse	(X/0) Parse any bytes received by the serial port
00030 0301 	; Packet format: (DD DD) DA SA D0 D1 D2 D3 D4 D5 D6 D7 (CS)
00031 0301 	;  DD = Sync byte added if address is received
00032 0301 	;  DA = Destination Address, SA = Source Address, 
00033 0301 	;       Dn = Data, CS Check Sum (xor of Address and Data bytes)
00034 0301 	;  SA RS485_SAddr ( the sender )
00035 0301 	;  DA must be RS485_MyAddr ( this program, must match )
00036 0301 	;  If the checksum matches put the data bytes in the RX485_Data buffer,
00037 0301 	;   set RX485DataValidFlag and RX485DataIsNew.
00038 0301 	;=========================================================================================
00039 0301 	;
00040 0301 	; default to a 6 byte packet 0xDD 0xDD DA SA D0 D1 D2 D3 CS
00041 0301 	;
00042 0301 	;
00043 0301 		ifndef RP485_DataBytes
00045 0301 		endif
00046 0301 	;
00047 0301 		ifndef UseRS485Chksum
00049 0301 		endif
00050 0301 	;
00051 0301 		constant RX485Timeout=5	;50 mS max between incoming bytes
00052 0301 	;=========================================================================================
00053 0301 	; Bank0 variable used by RS232_Parse:
00054 0301 	;
00055 0301 	;	cblock
00056 0301 	;	RS485_Address
00057 0301 	;	endc
00058 0301 	;
00059 0301 	; *** put in main loop
00060 0301 	;	CALL	RS485_Parse
00061 0301 	; if RX485DataValidFlag is set data may be used
00062 0301 	;
00063 0301 	;=========================================================================================
00064 0301 	; Parse any bytes received by the serial port
00065 0301 	;
00066 0301 	; Receive 0xDD,0xDD,SA0,DA0,Cmd,Data0,Data1,Data2,CS
00067 0301 	;
00068 0301 	;
00069 0301 	; Entry: none
00070 0301 	; Exit: none
00071 0301 	; Ram Used: Param78, FSR0
00072 0301 	; Calls (1+0): GetSer485In
00073 0301 	;
00074 0301 0144 	RS485_Parse	movlb	Ser485_Buff_Bank
00075 0302 08A0 		movf	RX485_ParseFlags,F
00076 0303 		SKPNZ		;Receive in process?
00076 0303 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00077 0304 3207 		bra	RS485_Parse_Byte	; no
00078 0305 	;
00079 0305 0140 		movlb	0	;bank 0
00080 0306 08B4 		movf	Timer2Lo,F
00081 0307 		SKPZ		;Timed out?
00081 0307 1D03      M		BTFSS	STATUS,Z		BTFSS	STATUS,Z
00082 0308 3203 		bra	RS485_Parse_Byte	; no
00083 0309 	;timed out
00084 0309 15BF 		bsf	RS485RX_Timeout
00085 030A 0144 		movlb	Ser485_Buff_Bank
00086 030B 01A0 		clrf	RX485_ParseFlags
00087 030C 	;
00088 030C 22BB 	RS485_Parse_Byte	CALL	GetSer485In
00089 030D 1C78 		btfss	Param78,0	;Got a byte?
00090 030E 0008 		return		; No
00091 030F 	;
00092 030F 00F8 		movwf	Param78	;Data Byte RXd
00093 0310 3005 		movlw	RX485Timeout	;Reset time-out timer
00094 0311 00B4 		movwf	Timer2Lo
00095 0312 	; Command inturpreter
00096 0312 		if UseRS485SyncBytes
00097 0312 	;
00098 0312 0144 		movlb	Ser485_Buff_Bank	;bank 4
00099 0313 08A0 		movf	RX485_ParseFlags,F
00100 0314 		SKPZ		;Beginning new packet?
00100 0314 1D03      M		BTFSS	STATUS,Z		BTFSS	STATUS,Z
00101 0315 3205 		bra	RS485_Parse_Sync2	; No
00102 0316 	;
00103 0316 30DD 		movlw	kRS485SyncByteValue
00104 0317 0278 		subwf	Param78,W
00105 0318 		SKPNZ		;Sync byte OK?
00105 0318 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00106 0319 1420 		bsf	RS485SyncByte1RXd	; Yes
00107 031A 3216 		bra	RS485_Parse_Rtn
00108 031B 	;
00109 031B 18A0 	RS485_Parse_Sync2	btfsc	RS485SyncByte2RXd	;Second sync byte rec'd?
00110 031C 3206 		bra	RS485_Parse_SALo	; Yes
00111 031D 	;
00112 031D 30DD 		movlw	kRS485SyncByteValue
00113 031E 0278 		subwf	Param78,W
00114 031F 		SKPZ		;Got the second sync byte?
00114 031F 1D03      M		BTFSS	STATUS,Z		BTFSS	STATUS,Z
00115 0320 2B6F 		goto	RS485_Parse_Error	; No, need 2
00116 0321 14A0 		bsf	RS485SyncByte2RXd
00117 0322 320E 		bra	RS485_Parse_Rtn
