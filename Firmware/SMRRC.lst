00140 0344 1B39 		btfsc	RS485SourceAddLoRXd
00141 0345 320F 		bra	RS485_Parse_SALo_end
00142 0346 	;
00143 0346 01A3 		clrf	RX485_CSUM
00144 0347 01A2 		clrf	RX485_DataCount
00145 0348 1521 		bsf	RX485SrcIsMaster
00146 0349 0140 		movlb	0
